// NutriBone — Prisma schema (PostgreSQL)
// Single online store: shared catalog with one stock count per product,
// delivery-only orders, global admin/staff accounts. No physical branches.

generator client {
  provider      = "prisma-client-js"
  // native = this machine / build box; rhel-openssl-3.0.x = Netlify (AWS Lambda) functions
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations need a direct (non-pooled) connection. Locally / on a VPS set it
  // to the same value as DATABASE_URL; on Neon use the non "-pooler" URL.
  directUrl = env("DIRECT_URL")
}

// ---------- Catalog ----------

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  image       String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  brand          String?     // e.g. "NutriBone", "NutriGlow"
  contents       String?     // e.g. "150 ml", "500 ml", "7 × 150 ml"
  details        String?     // e.g. "Original", "Antiinflamatorio", "Sin conservantes"

  id             String      @id @default(cuid())
  name           String
  slug           String      @unique
  description    String?
  // Price in Bs (bolivianos), stored as Decimal for money-safe math.
  // 0 = placeholder ("precio por confirmar") until the client sets it in admin.
  price          Decimal     @db.Decimal(10, 2)
  compareAtPrice Decimal?    @db.Decimal(10, 2)
  sku            String?     @unique
  images         String[]    @default([])
  material       String?     // presentation, e.g. "Vaso 150 ml", "Frasco 500 ml"
  specs          String?     // per-product specs, one "Label: Value" per line
  stock          Int         @default(0)
  featured       Boolean     @default(false)
  active         Boolean     @default(true)
  category       Category    @relation(fields: [categoryId], references: [id])
  categoryId     String
  orderItems     OrderItem[]
  loyaltyEntries LoyaltyEntry[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([categoryId])
  @@index([featured])
}

// ---------- Orders ----------

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD       // pago contra entrega
  TRANSFER  // QR / transferencia, coordinado por WhatsApp
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique
  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod @default(COD)
  paymentStatus PaymentStatus @default(PENDING)

  // Customer (guest checkout supported; linked to an account when signed in)
  customerName  String
  email         String
  phone         String
  // Delivery address (delivery-only store)
  address       String
  city          String
  postalCode    String?
  notes         String?

  // Optional link to a registered customer account
  customer      Customer?     @relation(fields: [customerId], references: [id])
  customerId    String?

  // Money (Bs)
  subtotal      Decimal       @db.Decimal(10, 2)
  shipping      Decimal       @default(0) @db.Decimal(10, 2)
  total         Decimal       @db.Decimal(10, 2)

  // Courier shipment
  courier         String?
  trackingNumber  String?
  shippedAt       DateTime?

  items         OrderItem[]
  loyaltyEntries LoyaltyEntry[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status])
  @@index([email])
  @@index([customerId])
  @@index([createdAt])
}

model OrderItem {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  // Snapshots so historical orders stay accurate if the product changes
  name      String
  price     Decimal  @db.Decimal(10, 2)
  quantity  Int

  @@index([orderId])
}

// ---------- Admin ----------

enum Role {
  ADMIN
  STAFF
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Storefront customer accounts (separate from admin `User`).
model Customer {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  phone        String?
  // Set once the customer proves they own the email (OTP). Null = unverified
  // (accounts created before OTP existed, or via checkout sign-up).
  emailVerifiedAt DateTime?
  orders       Order[]
  redemptions  Redemption[]
  loyaltyEntries LoyaltyEntry[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// One-time email codes (OTP). Only a hash of the code is stored.
//  purpose "register": pending sign-up — payload holds name + passwordHash until verified.
//  purpose "verify":   an existing customer confirming their email.
model EmailVerification {
  id          String   @id @default(cuid())
  email       String
  purpose     String
  codeHash    String
  payload     Json?
  attempts    Int      @default(0)
  sendCount   Int      @default(1)
  lastSentAt  DateTime @default(now())
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@unique([email, purpose])
}

// ---------- Inbound (contact form + newsletter) ----------

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  topic     String?  // e.g. "notify:<category>"
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String?  // where they signed up (newsletter, notify:<category>)
  createdAt DateTime @default(now())
}

// ---------- Store settings (editable in Admin → Settings) ----------
// Key/value JSON, e.g. key "store" holds contact, socials, shipping, etc.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ---------- Loyalty (optional, disabled by default) ----------
// The ledger is append-only: a balance is the sum of its rows, so nothing can
// drift out of sync with the history that produced it. Stamps are signed and
// grouped by product (10 of the same product = that product free); points are
// signed and pooled (spent in the rewards shop).

enum LoyaltyKind {
  STAMP         // a qualifying unit bought
  POINT         // spend converted into points
  REDEEM_STAMP  // stamps spent on a free unit at checkout
  REDEEM_PRIZE  // points spent on a reward
  REFUND        // reversed after a cancellation
  ADJUST        // manual correction by staff
}

enum RedemptionStatus {
  PENDING    // claimed, being prepared
  READY      // ready to hand over / send out
  COLLECTED  // handed over
  CANCELLED  // points refunded
}

model Reward {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  description String?
  image       String?
  costPoints  Int
  stock       Int          @default(0)
  active      Boolean      @default(true)
  order       Int          @default(0)
  redemptions Redemption[]
  loyaltyEntries LoyaltyEntry[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([active, order])
}

model Redemption {
  id         String           @id @default(cuid())
  // Short code the customer shows when claiming the reward
  code       String           @unique
  customer   Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  reward     Reward           @relation(fields: [rewardId], references: [id])
  rewardId   String
  // Snapshot: the reward can be renamed or removed later
  rewardName String
  costPoints Int
  status     RedemptionStatus @default(PENDING)
  note       String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([customerId])
}

model LoyaltyEntry {
  id         String      @id @default(cuid())
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  kind       LoyaltyKind
  // Signed: positive earns, negative spends. Zero when the row only moves points.
  stamps     Int         @default(0)
  points     Int         @default(0)
  product    Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId  String?
  order      Order?      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId    String?
  reward     Reward?     @relation(fields: [rewardId], references: [id], onDelete: SetNull)
  rewardId   String?
  // Why the row exists — required for ADJUST, free text otherwise
  note       String?
  createdAt  DateTime    @default(now())

  @@index([customerId, kind])
  @@index([customerId, productId])
  @@index([orderId])
}