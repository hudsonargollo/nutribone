# ---- Database (PostgreSQL) ----
# Local example:
#   DATABASE_URL="postgresql://postgres:password@localhost:5432/nutribone?schema=public"
# Hosted (Neon/Supabase) — copy the connection string from your dashboard:
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/nutribone?schema=public"
# Direct (non-pooled) connection for migrations — same as DATABASE_URL unless
# you use a pooler (Neon "-pooler" host): then put the non-pooled URL here.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/nutribone?schema=public"

# ---- App ----
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---- Auth (REQUIRED in production) ----
# Signs admin + customer sessions and password-reset links. The app refuses to
# start sessions in production without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-string"
# Bootstrap admin login (used when no DB user exists yet)
ADMIN_EMAIL="admin@nutribone.clubemkt.digital"
ADMIN_PASSWORD="change-me"

# ---- Payments ----
# NutriBone is delivery-only with two methods: COD (pago contra entrega) and
# TRANSFER (QR / transferencia, coordinado por WhatsApp). No gateway keys needed.

# ---- Email (sign-up verification codes, order confirmations, magic links) ----
# Preferred: Resend (https://resend.com) — set RESEND_API_KEY and verify the
# sending domain, done. Falls back to the SMTP block below when no key is set.
RESEND_API_KEY=""
MAIL_FROM="NutriBone <pedidos@nutribone.clubemkt.digital>"
ADMIN_NOTIFY_EMAIL=""        # store owner's email for new-order alerts
# SMTP fallback (any provider). In dev without either, codes are printed in the terminal.
# Gmail example: host smtp.gmail.com, port 587, user = your gmail,
# pass = a Google "App Password" (not your normal password).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"          # true only for port 465
SMTP_USER=""
SMTP_PASS=""

# ---- Store contact details (shown in footer / contact page / chat) ----
# Leave blank to hide an item — no placeholder numbers are shown.
NEXT_PUBLIC_WHATSAPP_NUMBER="59177313568"   # international format, digits only
NEXT_PUBLIC_CONTACT_PHONE="+591 77313568"   # display format
NEXT_PUBLIC_CONTACT_EMAIL=""                # blank = hidden (NutriBone is WhatsApp-first)
NEXT_PUBLIC_CONTACT_CITY="Santa Cruz de la Sierra"
NEXT_PUBLIC_CONTACT_HOURS="Atención por WhatsApp · hecho por encargo"
NEXT_PUBLIC_INSTAGRAM_URL="https://www.instagram.com/nutribone.scz"
NEXT_PUBLIC_FACEBOOK_URL=""
NEXT_PUBLIC_TIKTOK_URL="https://www.tiktok.com/@nutribone"

# ---- Shipping policy (Bs) ----
# Delivery is free inside the 4th ring; 0/0 keeps it free with no minimum.
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD="0"
NEXT_PUBLIC_FLAT_SHIPPING="0"

# ---- Couriers (Leopards / TCS) ----
# Without keys, booking is simulated in development only. In production it is
# refused unless COURIER_SIMULATION="true" (demo servers).
LEOPARDS_API_KEY=""
LEOPARDS_API_PASSWORD=""
LEOPARDS_ORIGIN_CITY="Santa Cruz"
TCS_USERNAME=""
TCS_PASSWORD=""
TCS_CLIENT_ID=""
TCS_CLIENT_SECRET=""
TCS_COST_CENTER=""
TCS_ORIGIN_CITY="Santa Cruz"
COURIER_SIMULATION=""

# ---- Uploads ----
# Admin-uploaded product images are stored here (default: ./uploads).
# Use a persistent volume in Docker (-v nutribone-uploads:/app/uploads).
UPLOAD_DIR=""

# ---- AI support chat (Claude) ----
# With a key, the chat bubble answers any customer question from the live catalog,
# store settings and policies (and can look up an order by number + email).
# Without it, the chat runs in basic mode (keyword answers + product search).
# Get a key at https://console.anthropic.com → API Keys. Billed per message.
ANTHROPIC_API_KEY=""
# Optional: model override (default claude-opus-5-5)
CHAT_MODEL=""